# Copy to server/.env and fill in. Never commit server/.env.

# --- Server ---
PORT=4000
# SQLite fallback (default). For PostgreSQL use postgresql://user:password@localhost:5432/sats_in_a_bottle
DATABASE_URL=file:./dev.db
# Comma-separated origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173
# Base of recipient share links: <PUBLIC_APP_URL>/bottle/<token>
PUBLIC_APP_URL=http://localhost:5173

# --- Bitcoin ---
# signet | testnet | mainnet
BITCOIN_NETWORK=signet
# Optional override; defaults to mempool.space for the chosen network.
MEMPOOL_API_URL=
MIN_CONFIRMATIONS=1
# How often the chain watcher polls (ms). 0 disables it.
WATCHER_INTERVAL_MS=30000

# --- Funding (M-Pesa -> Lightning via Bitika) ---
# bitika | none
FUNDING_PROVIDER=none
# test | live. live requires BITCOIN_NETWORK=mainnet and a bk_live_ key.
BITIKA_ENV=test
BITIKA_API_KEY=bk_test_replace_me
BITIKA_BASE_URL=https://bitikaserver.up.railway.app
# Shown once when you register the webhook with Bitika.
BITIKA_WEBHOOK_SECRET=
